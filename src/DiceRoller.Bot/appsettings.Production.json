{
  "Bot": {
    "Token": "",
    "CommandPrefix": "!roll",
    "EnableSlashCommands": true,
    "EnablePrefixCommands": true,
    "EnableButtonInteractions": true,
    "DiscordTimeoutSeconds": 30,
    "UseGlobalCommands": true,
    "TestGuildId": null
  },
  "Logging": {
    "MinimumLevel": "Information",
    "EnableConsole": true,
    "EnableFile": true,
    "LogFilePath": "logs/diceroller.log",
    "MaxFileSizeMB": 50,
    "RetainedFileCountLimit": 5,
    "Categories": {
      "DSharpPlus": "Information",
      "Microsoft": "Warning",
      "System": "Warning",
      "DiceRoller": "Information"
    }
  },
  "Plugins": {
    "Directory": "plugins",
    "AutoLoadAtStartup": true,
    "EnableHotReload": false,
    "OperationTimeoutSeconds": 30,
    "EnableSandboxing": true,
    "MaxMemoryUsageMB": 100,
    "AllowCommandRegistration": true,
    "AllowFunctionRegistration": true,
    "AllowedPlugins": [],
    "BlockedPlugins": []
  },
  "Security": {
    "MaxMessageLength": 2000,
    "EnableRateLimiting": true,
    "CommandsPerMinute": 60,
    "MaxExpressionComplexity": 5,
    "MaxDiceCount": 1000,
    "MaxDieSides": 100000,
    "LogSecurityViolations": true,
    "AutoBanViolators": false,
    "ViolationsBeforeBan": 10
  },
  "Environment": "Production",
  "Version": "1.0.0",
  "EnableHealthChecks": true,
  "HealthCheckIntervalSeconds": 300
}