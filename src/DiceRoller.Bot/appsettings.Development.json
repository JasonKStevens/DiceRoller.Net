{
  "Bot": {
    "Token": "",
    "CommandPrefix": "!roll",
    "EnableSlashCommands": true,
    "EnablePrefixCommands": false,
    "EnableButtonInteractions": true,
    "DiscordTimeoutSeconds": 30,
    "UseGlobalCommands": false,
    "TestGuildId": null
  },
  "Logging": {
    "MinimumLevel": "Debug",
    "EnableConsole": true,
    "EnableFile": true,
    "LogFilePath": "logs/diceroller-dev.log",
    "MaxFileSizeMB": 10,
    "RetainedFileCountLimit": 3,
    "Categories": {
      "DSharpPlus": "Debug",
      "Microsoft": "Information",
      "System": "Information",
      "DiceRoller": "Debug"
    }
  },
  "Plugins": {
    "Directory": "plugins",
    "AutoLoadAtStartup": true,
    "EnableHotReload": true,
    "OperationTimeoutSeconds": 30,
    "EnableSandboxing": false,
    "MaxMemoryUsageMB": 100,
    "AllowCommandRegistration": true,
    "AllowFunctionRegistration": true,
    "AllowedPlugins": [],
    "BlockedPlugins": []
  },
  "Security": {
    "MaxMessageLength": 2000,
    "EnableRateLimiting": false,
    "CommandsPerMinute": 1000,
    "MaxExpressionComplexity": 5,
    "MaxDiceCount": 10000,
    "MaxDieSides": 1000000,
    "LogSecurityViolations": true,
    "AutoBanViolators": false,
    "ViolationsBeforeBan": 10
  },
  "Environment": "Development",
  "Version": "1.0.0",
  "EnableHealthChecks": true,
  "HealthCheckIntervalSeconds": 60
}