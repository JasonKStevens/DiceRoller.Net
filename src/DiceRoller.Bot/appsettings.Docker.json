{
  "Bot": {
    "Token": "",
    "CommandPrefix": "!roll",
    "EnableSlashCommands": true,
    "EnablePrefixCommands": false,
    "EnableButtonInteractions": true,
    "DiscordTimeoutSeconds": 60,
    "UseGlobalCommands": true,
    "TestGuildId": null
  },
  "Logging": {
    "MinimumLevel": "Information",
    "EnableConsole": true,
    "EnableFile": false,
    "LogFilePath": null,
    "MaxFileSizeMB": 50,
    "RetainedFileCountLimit": 5,
    "Categories": {
      "DSharpPlus": "Information",
      "Microsoft": "Warning",
      "System": "Warning",
      "DiceRoller": "Information"
    }
  },
  "Plugins": {
    "Directory": "/app/plugins",
    "AutoLoadAtStartup": true,
    "EnableHotReload": false,
    "OperationTimeoutSeconds": 60,
    "EnableSandboxing": true,
    "MaxMemoryUsageMB": 50,
    "AllowCommandRegistration": true,
    "AllowFunctionRegistration": true,
    "AllowedPlugins": [],
    "BlockedPlugins": []
  },
  "Security": {
    "MaxMessageLength": 2000,
    "EnableRateLimiting": true,
    "CommandsPerMinute": 30,
    "MaxExpressionComplexity": 4,
    "MaxDiceCount": 500,
    "MaxDieSides": 10000,
    "LogSecurityViolations": true,
    "AutoBanViolators": false,
    "ViolationsBeforeBan": 5
  },
  "Environment": "Docker",
  "Version": "1.0.0",
  "EnableHealthChecks": true,
  "HealthCheckIntervalSeconds": 300
}